<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31). `riffet.device` is the device token store in shared/Platform.android.kt. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="riffet.device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="riffet.device.xml" />
    </device-transfer>
</data-extraction-rules>
