        <!--
          Keeps the process alive while a session stream is open, so backgrounding the app does not
          cost a reconnect. `specialUse` on Android 14+, which has no daily limit (`dataSync` stops
          after six hours on Android 15+); `dataSync` before it. The app is sideloaded, so the
          subtype is for the record, not a store review.
        -->
        <service
            android:name=".RiffetSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the connection to the user's own Riffet server so approvals and turn results arrive as local notifications, and, when the owner allows it, so the owner's agents can reach this device; no push service is used." />
        </service>

        <!--
          One device call that needs a window: a clipboard read, the camera or photo picker, or
          starting another app. Transparent and in its own task, over whatever the owner was using.
        -->
        <activity
            android:name=".DeviceActionActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Riffet.QuickChat" />
        <!--
          T1 screen control (docs/DEVICES.md §3「协议（R3，T1）」): reads and drives the main display
          only for calls the owner allowed on this device; see ScreenActionGate.
        -->
        <service
            android:name=".RiffetAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        <!-- Lease alarms, dismissed device requests and 停止; only this app's PendingIntents reach it. -->
        <receiver
            android:name=".DeviceReceiver"
            android:exported="false" />
        <!-- System broadcasts only; the receiver ignores any other action. -->
        <receiver
            android:name=".DeviceBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- A notification's dialog buttons and reply field; only this app's PendingIntents reach it. -->
        <receiver
            android:name=".RiffetNotificationReceiver"
            android:exported="false" />

        <!-- 快速对话 in the Quick Settings panel; it opens the same entry as the shortcut. -->
        <service
            android:name=".QuickChatTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_chat"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
