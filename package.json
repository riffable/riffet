{
  "name": "riffet",
  "version": "0.7.0",
  "buildNumber": 26111202,
  "private": true,
  "type": "module",
  "description": "A self-hosted workbench for native Cursor, Codex, Claude Code, DeepSeek Harness, Factory Droid and TRAE CLI sessions, reachable from a browser, Mac or phone",
  "license": "Apache-2.0",
  "bin": {
    "riffet": "scripts/riffet.mjs",
    "riffet-server": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "tsx apps/server/src/cli.ts --dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/build-info.mjs --build",
    "start": "node dist/cli.js",
    "pack:npm": "node scripts/pack-npm.mjs",
    "typecheck": "tsc --noEmit",
    "check:case": "node scripts/check-case-collisions.mjs",
    "check:plugins": "node scripts/check-plugin-boundaries.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:public-artifacts": "node scripts/check-public-artifacts.mjs",
    "check:mobile-strings": "node scripts/check-mobile-strings.mjs",
    "check:compose": "node scripts/check-compose-pitfalls.mjs",
    "check:motion": "node scripts/check-web-motion.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:docs": "node scripts/check-doc-paths.mjs",
    "check:design": "node scripts/check-design-rules.mjs",
    "check:perf": "node scripts/check-perf-rules.mjs",
    "trace:android": "node scripts/android-frame-trace.mjs",
    "i18n:extract": "lingui extract --clean --config apps/web/lingui.config.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "replay:transcript": "tsx scripts/replay-transcript.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx apps/server/src/cli.ts doctor",
    "gen:brand": "tsx scripts/gen-brand.ts",
    "gen:theme": "tsx scripts/gen-mobile-theme.ts",
    "gen:theme:check": "tsx scripts/gen-mobile-theme.ts --check",
    "gen:tokens": "tsx scripts/gen-design-tokens.ts",
    "gen:tokens:check": "tsx scripts/gen-design-tokens.ts --check",
    "gen:styles": "tsx scripts/gen-interface-styles.ts",
    "gen:styles:check": "tsx scripts/gen-interface-styles.ts --check",
    "gen:plugin-style": "tsx scripts/gen-plugin-style.ts",
    "gen:plugin-style:check": "tsx scripts/gen-plugin-style.ts --check",
    "gen:mac-icons": "tsx scripts/gen-macos-icons.ts",
    "gen:mac-icons:check": "tsx scripts/gen-macos-icons.ts --check",
    "gen:icons": "tsx scripts/gen-mobile-icons.ts",
    "gen:icons:check": "tsx scripts/gen-mobile-icons.ts --check && tsx scripts/gen-icon-packs.ts --check",
    "gen:icon-packs": "tsx scripts/gen-icon-packs.ts",
    "gen:i18n": "tsx scripts/gen-i18n.ts",
    "gen:i18n:check": "tsx scripts/gen-i18n.ts --check",
    "gen:timeline-fixtures": "tsx scripts/gen-timeline-fixtures.ts",
    "gen:timeline-fixtures:check": "tsx scripts/gen-timeline-fixtures.ts --check",
    "gen:budgets": "tsx scripts/gen-budgets.ts",
    "gen:budgets:check": "tsx scripts/gen-budgets.ts --check",
    "gen:contracts": "tsx scripts/gen-contracts.ts",
    "gen:contracts:check": "tsx scripts/gen-contracts.ts --check",
    "gen:plugin-api": "tsx scripts/gen-plugin-api-released.ts",
    "gen:plugin-api:check": "tsx scripts/gen-plugin-api-released.ts --check",
    "gen:prompts": "tsx scripts/gen-prompts.ts",
    "gen:prompts:check": "tsx scripts/gen-prompts.ts --check",
    "version:bump": "tsx scripts/version.ts",
    "version:check": "tsx scripts/version.ts --check",
    "release:notes": "node scripts/release.mjs notes",
    "release:prepare": "node scripts/release.mjs prepare",
    "gen:marks": "tsx scripts/gen-agent-marks.ts",
    "gen:marks:check": "tsx scripts/gen-agent-marks.ts --check",
    "build:plugin-sdk": "node scripts/build-plugin-sdk.mjs",
    "build:site": "tsx scripts/build-site.ts"
  },
