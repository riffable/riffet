{
  "id": "riffet.share-s3",
  "vendor": "riffet",
  "name": "share-s3",
  "apiVersion": 1,
  "defaultEnabled": false,
  "version": "1.0.0",
  "title": {
    "zh-Hans": "S3 分享",
    "en": "S3 Share"
  },
  "description": {
    "zh-Hans": "把会话分享发布到 S3 兼容的对象存储",
    "en": "Publishes shared conversations to S3-compatible object storage"
  },
  "contributes": {
    "sharePublisher": {
      "title": {
        "zh-Hans": "S3",
        "en": "S3"
      }
    },
    "page": {
      "title": {
        "zh-Hans": "设置",
        "en": "Settings"
      }
    }
  },
  "settings": [
    { "key": "endpoint", "label": "Endpoint", "kind": "text" },
    { "key": "region", "label": "Region", "kind": "text" },
    { "key": "bucket", "label": "Bucket", "kind": "text" },
    { "key": "prefix", "label": "Key prefix", "kind": "text" },
    { "key": "addressing", "label": "Addressing", "kind": "text" },
    { "key": "publicBaseUrl", "label": "Public base URL", "kind": "text" },
    { "key": "accessKeyId", "label": "Access key ID", "kind": "text" },
    { "key": "secretAccessKey", "label": "Secret access key", "kind": "secret" }
  ],
  "entries": {
    "server": "server/index.mjs"
  },
  "hostApi": {
    "server": "^1"
  },
  "capabilities": [
    "network"
  ],
  "activation": [
    "startup"
  ],
  "requiresTrustedHost": true
}
